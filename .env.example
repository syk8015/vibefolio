# Nookframe environment — copy to .env.local and fill in.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.

# ── Supabase (auth + DB + storage for uploads/avatars) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auto-demo pipeline ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # computer-use (explore pass)
E2B_API_KEY=                  # sandbox build/serve (both local + cloud paths)
TRIGGER_SECRET_KEY=           # Trigger.dev v4 (cloud fallback path)
TRIGGER_PROJECT_REF=
# Route demo jobs to the local M5 recorder (npm run demo:worker) instead of the
# E2B cloud task. Set to "local" in the environment that runs the worker.
DEMO_RUNNER=local
# Optional: override the computer-use model (default claude-sonnet-4-5).
DEMO_CU_MODEL=

# ── Cloudflare R2 (demo mp4 + poster storage) ─────────────────────────────────
# When all five are set, demo videos/posters upload to R2; otherwise the pipeline
# falls back to Supabase Storage automatically (isR2Configured() in lib/r2.ts).
# R2_PUBLIC_URL_BASE = the bucket's public base (r2.dev subdomain or custom domain,
# e.g. https://cdn.nookframe.com). No trailing slash needed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL_BASE=

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
# Errors only (no traces) — free tier. Leave blank to disable entirely.
# App server + client only send when NODE_ENV=production (so local `next dev`
# stays quiet even with these set); the recorder worker sends whenever SENTRY_DSN
# is present. Use the same DSN for both unless you want separate projects.
SENTRY_DSN=                   # server (API/SSR) + local recorder worker
NEXT_PUBLIC_SENTRY_DSN=       # browser (exposed to client — this is expected for Sentry)

# ── Watchdog cron (P0.4) ──────────────────────────────────────────────────────
# Shared secret an EXTERNAL free cron (cron-job.org etc.) sends to GET
# /api/cron/health to reap stuck jobs + alert on a dead worker. Send it as either
# `Authorization: Bearer <secret>` or `?key=<secret>`. Unset => the route 503s.
CRON_SECRET=

# ── Legacy / unused ───────────────────────────────────────────────────────────
# Browserbase was replaced by E2B Playwright (2026-05); code no longer reads these.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
